#this is a 'generic' .gitignore file for Python projects. It ignores common files and directories that are not needed in version control
#written by github copilot

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Coverage and build outputs
.coverage
.coverage.*
htmlcov/
build/
dist/
site/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files
.env
.env.*
